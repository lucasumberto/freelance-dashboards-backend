generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int            @id @default(autoincrement())
  name          String
  client        String
  status        String
  startDate     String
  endDate       String?
  budget        Float
  actualCost    Float          @default(0)
  progress      Int            @default(0)
  description   String?
  transactions  Transaction[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  description String
  date        String
  category    String
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Revenue {
  id        Int      @id @default(autoincrement())
  month     String
  amount    Float
  projected Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  company       String?
  phone         String?
  status        String   @default("active")
  totalProjects Int      @default(0)
  totalSpent    Float    @default(0)
  lastContact   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
